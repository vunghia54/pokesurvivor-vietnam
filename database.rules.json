{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "$connId": {
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber() && !newData.hasChild('name') && !newData.hasChild('email') && !newData.hasChild('ip') && !newData.hasChild('token')"
        }
      }
    },
    "rooms": {
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (!newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "!newData.exists() || (!data.exists() ? (newData.hasChildren(['host', 'open', 'at', 'm']) && !newData.hasChild('q')) : true)",
        "host": {
          ".read": "auth != null",
          ".write": false
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        },
        "at": {
          ".read": "auth != null"
        },
        "m": {
          ".read": "auth != null && (data.child(auth.uid).exists() || root.child('rooms').child($room).child('open').val() === true)",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || data.exists() || root.child('rooms').child($room).child('open').val() === true)) || (!newData.exists() && root.child('rooms').child($room).child('host').val() === auth.uid))",
            ".validate": "!newData.exists() || (auth.uid === $uid && newData.hasChildren(['name', 'dex']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('dex').isNumber())"
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && ((!newData.exists() && auth.uid === $to) || (newData.exists() && root.child('rooms').child($room).child('m').child(auth.uid).exists()))",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 200000)"
            }
          }
        }
      }
    }
  }
}
