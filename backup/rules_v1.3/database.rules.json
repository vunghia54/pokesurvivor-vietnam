{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "$connId": {
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber() && !newData.hasChild('name') && !newData.hasChild('email') && !newData.hasChild('ip') && !newData.hasChild('token')"
        }
      }
    },
    "rooms": {
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (!newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "newData.hasChildren(['host', 'open', 'at', 'm', 'slots']) && (data.exists() || !newData.hasChild('q'))",
        "host": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "slots": {
          ".read": "auth != null",
          "$slot": {
            ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && (root.child('rooms').child($room).child('open').val() === true || data.val() === auth.uid)) || (!newData.exists() && (data.val() === auth.uid || root.child('rooms').child($room).child('host').val() === auth.uid) && !newData.parent().parent().child('m').child(data.val()).exists()))",
            ".validate": "$slot.matches(/^[0-3]$/) && newData.isString() && newData.val() === auth.uid && newData.parent().parent().child('m').child(auth.uid).child('slot').val() === $slot"
          }
        },
        "m": {
          ".read": "auth != null && (data.child(auth.uid).exists() || root.child('rooms').child($room).child('open').val() === true)",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || data.exists() || root.child('rooms').child($room).child('open').val() === true || root.child('rooms').child($room).child('slots').child(newData.child('slot').val()).val() === auth.uid)) || (!newData.exists() && root.child('rooms').child($room).child('host').val() === auth.uid))",
            ".validate": "auth.uid === $uid && newData.hasChildren(['name', 'dex', 'slot']) && newData.parent().parent().child('slots').child(newData.child('slot').val()).val() === $uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "dex": {
              ".validate": "newData.isNumber()"
            },
            "shiny": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "slot": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-3]$/) && (!data.exists() || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null && auth.uid === $to && root.child('rooms').child($room).child('m').child(auth.uid).exists()",
            "$msg": {
              ".write": "auth != null && ((!newData.exists() && auth.uid === $to) || (!data.exists() && newData.exists() && $msg.beginsWith(auth.uid + '~') && root.child('rooms').child($room).child('m').child(auth.uid).exists() && root.child('rooms').child($room).child('m').child($to).exists() && (auth.uid === root.child('rooms').child($room).child('host').val() || $to === root.child('rooms').child($room).child('host').val())))",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 200000)"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
